---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import StructuredData from '../components/StructuredData.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config';
import {
  getAuthorTranslations,
  getLocale,
  getLocaleFromPath,
  getPageTranslations,
  localizePath,
} from '../i18n/utils';

const locale = getLocale(
  Astro.url.searchParams.get('_locale') ||
  Astro.locals.locale ||
  getLocaleFromPath(Astro.url.pathname)
);
const author = getAuthorTranslations(locale);
const page = getPageTranslations(locale).home;
const isArabic = locale === 'ar';
const projects = (await getCollection('projects')).sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
const skills = (await getCollection('uses')).sort(
  (a, b) => (a.data.order || 99) - (b.data.order || 99)
);
const journey = (await getCollection('journey')).sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const workEntries = journey.filter((entry) =>
  ['milestone', 'transition'].includes(entry.data.type)
);
const educationEntry = journey.find((entry) => entry.data.type === 'education');
const skillItems = skills.flatMap((entry) => entry.data.items);

const copy = isArabic
  ? {
      status: 'مطور Backend متخصص في ASP.NET Core APIs وأمن التطبيقات',
      title: 'مطور Backend يبني RESTful APIs آمنة.',
      emphasis: 'باستخدام ASP.NET Core وJWT وRBAC.',
      intro: 'مطور Backend بخبرة عملية في بناء RESTful APIs آمنة، وتصميم قواعد البيانات العلائقية، وتطبيق JWT وRBAC، واختبار أمن التطبيقات والـAPIs باستخدام Burp Suite.',
      primary: 'عرض المشاريع',
      secondary: 'تواصل معي',
      requestCv: 'تحميل السيرة الذاتية',
      overview: 'نظرة عامة',
      projects: 'مشاريع مختارة',
      projectsIntro: 'حلول Backend وAPI مبنية باستخدام تقنيات عملية وقابلة للتوسع.',
      security: 'أمن التطبيقات',
      securityIntro: 'أتعامل مع الأمن كجزء من تطوير API، من المصادقة والصلاحيات إلى تحليل حركة المرور واختبار الثغرات.',
      architecture: 'هندسة Backend وDevOps',
      architectureIntro: 'تركيز عملي على بناء خدمات واضحة الحدود وقواعد بيانات منظمة وتدفقات وصول آمنة.',
      stack: 'المهارات والتقنيات',
      stackIntro: 'التقنيات والأدوات المستخدمة في تطوير Backend وAPI وأمن التطبيقات وربط الواجهات الأمامية.',
      experience: 'الخبرة والتعليم',
      experienceIntro: 'الخبرة المهنية والتعليم واللغات.',
      contact: 'لنتواصل',
      contactIntro: 'للتواصل بشأن فرص تطوير Backend وAPI والمشاريع البرمجية.',
      work: 'الخبرة العملية',
      education: 'التعليم',
      languages: 'اللغات',
      email: 'البريد الإلكتروني',
      phone: 'الهاتف',
      location: 'الموقع',
      linkedin: 'LinkedIn',
      github: 'GitHub',
      inProgress: 'قيد التطوير',
      project: 'مشروع',
    }
  : {
      status: 'Backend Developer focused on ASP.NET Core APIs and Application Security',
      title: 'I build secure RESTful APIs.',
      emphasis: 'Using ASP.NET Core, JWT, and RBAC.',
      intro: 'Backend Developer with hands-on experience building secure RESTful APIs, designing relational databases, implementing JWT/RBAC, and testing web/API security using Burp Suite.',
      primary: 'View Projects',
      secondary: 'Get In Touch',
      requestCv: 'Download CV',
      overview: 'About',
      projects: 'Selected Projects',
      projectsIntro: 'Backend and API solutions built with practical, scalable technologies.',
      security: 'Application Security',
      securityIntro: 'Security work across authentication, authorization, traffic analysis, and application security testing.',
      architecture: 'Architecture & DevOps',
      architectureIntro: 'Practical experience with API Gateway, Strangler Fig Pattern, Layered Architecture, Docker, Git, and backend integration.',
      stack: 'Skills & Technical Stack',
      stackIntro: 'Technologies and tools used across backend development, APIs, application security, and frontend integration.',
      experience: 'Experience & Education',
      experienceIntro: 'Professional experience, education, and languages.',
      contact: 'Let\'s Connect',
      contactIntro: 'For backend development, API opportunities, and challenging software projects.',
      work: 'Work Experience',
      education: 'Education',
      languages: 'Languages',
      email: 'Email',
      phone: 'Phone',
      location: 'Location',
      linkedin: 'LinkedIn',
      github: 'GitHub',
      inProgress: 'In progress',
      project: 'Project',
    };

const displayValue = (entry: any, key: string) => isArabic ? entry.data[`${key}Ar`] || entry.data[key] : entry.data[key];
const displaySkills = skillItems.slice(0, 18);
---

<BaseLayout>
  <SEO slot="head" title={page.title} description={page.description} type="website" noSuffix />
  <StructuredData type="WebSite" />
  <StructuredData type="Person" data={{ skills: displaySkills.map((item) => item.name) }} />

  <main class="stitch-home">
    <section class="stitch-hero section-frame" id="overview">
      <div class="hero-glow hero-glow-cyan" aria-hidden="true"></div>
      <div class="hero-glow hero-glow-violet" aria-hidden="true"></div>
      <div class="content-frame hero-grid">
        <div class="hero-copy">
          <div class="status-pill"><span class="status-dot"></span><span>{copy.status}</span></div>
          <h1>{copy.title}<br /><span>{copy.emphasis}</span></h1>
          <p class="hero-intro">{copy.intro}</p>
          <div class="hero-pillars" aria-label={copy.stack}>
            <div class="pillar"><span>01 / BACKEND</span><strong>ASP.NET Core</strong></div>
            <div class="pillar"><span>02 / API</span><strong>REST APIs</strong></div>
            <div class="pillar"><span>03 / SECURITY</span><strong>AppSec</strong></div>
          </div>
          <div class="hero-actions">
            <a class="stitch-button stitch-button-primary" href={localizePath('/projects', locale)}>{copy.primary}<span aria-hidden="true">↓</span></a>
            <a class="stitch-button stitch-button-secondary" href={localizePath('/contact', locale)}>{copy.secondary}<span aria-hidden="true">↗</span></a>
            <a class="stitch-button stitch-button-quiet" href="/cv/Abdallah-Ahmad-Hijazi-CV.pdf" download>{copy.requestCv}<span aria-hidden="true">↓</span></a>
          </div>
          <div class="verification-row">
            <a dir="ltr" href={siteConfig.social.github} target="_blank" rel="noopener noreferrer"><b>GH/</b> {siteConfig.social.github.replace('https://', '')}</a>
            <a dir="ltr" href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer"><b>IN/</b> {siteConfig.social.linkedin.replace('https://', '')}</a>
            <span><b>LOC/</b> {author.location}</span>
          </div>
        </div>
        <div class="profile-frame" aria-label={siteConfig.author.name}>
          <div class="profile-placeholder">
            <img src="/images/profile.jpg" alt="Abdallah Ahmad Hijazi" loading="eager" decoding="async" />
          </div>
          <div class="profile-caption"><strong>{siteConfig.author.name}</strong><span>{author.title}</span><small><i></i>{copy.status}</small></div>
        </div>
      </div>
    </section>

    <section class="stitch-section section-frame" id="projects">
      <div class="content-frame">
        <header class="section-heading"><div><span class="section-index">DOSSIER // 01</span><h2>{copy.projects}</h2></div><p>{copy.projectsIntro}</p></header>
        <div class="project-grid">
          {projects.map((project) => (
            <a class="project-panel" href={localizePath(`/projects/${project.id}`, locale)}>
              <div class="panel-topline"><span>{copy.project} · {isArabic
                                                ? project.data.roleAr || project.data.role || 'مطور Backend'
                                                : project.data.role || 'Backend Developer'}</span><em>{project.data.status === 'ongoing' ? copy.inProgress : '—'}</em></div>
              <h3>{displayValue(project, 'title')}</h3>
              <p>{displayValue(project, 'outcomeSummary')}</p>
              <div class="token-row">{project.data.techStack.map((tech) => <span class="tech-token">{tech}</span>)}</div>
              <span class="panel-link">{isArabic ? 'عرض التفاصيل ↗' : 'View project ↗'}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="stitch-section section-frame section-alt" id="security">
      <div class="content-frame two-column-section">
        <header class="section-heading section-heading-side"><span class="section-index">SECURITY BY DESIGN // 02</span><h2>{copy.security}</h2><p>{copy.securityIntro}</p></header>
        <div class="feature-grid">
          <article class="feature-panel"><span class="feature-number">01</span><h3>{isArabic ? 'المصادقة والصلاحيات' : 'Authentication & Authorization'}</h3><p>{isArabic ? 'تطبيق JWT وRBAC لبناء تدفقات وصول واضحة وآمنة.' : 'JWT and RBAC implementation for clear, secure access flows.'}</p><div class="token-row"><span class="tech-token">JWT</span><span class="tech-token">RBAC</span></div></article>
          <article class="feature-panel"><span class="feature-number">02</span><h3>{isArabic ? 'اختبار أمن التطبيقات' : 'Application Security Testing'}</h3><p>{isArabic ? 'اختبار وتحليل حركة مرور API وتطبيقات Android باستخدام أدوات متخصصة.' : 'Testing and traffic analysis for APIs and Android applications using dedicated security tools.'}</p><div class="token-row"><span class="tech-token">Burp Suite</span><span class="tech-token">OWASP ZAP</span><span class="tech-token">Nmap</span></div></article>
        </div>
      </div>
    </section>

    <section class="stitch-section section-frame" id="architecture">
      <div class="content-frame two-column-section architecture-layout">
        <header class="section-heading section-heading-side"><span class="section-index">FOUNDATION // 03</span><h2>{copy.architecture}</h2><p>{copy.architectureIntro}</p></header>
        <div class="architecture-board"><div class="board-callout"><span>{isArabic ? 'مجالات العمل' : 'Areas of practice'}</span><strong>{isArabic ? 'تنظيم Backend وفصل الخدمات' : 'Structured backend and service separation'}</strong></div><div class="architecture-list"><div><b>01</b><span>API Gateway</span></div><div><b>02</b><span>Strangler Fig Pattern</span></div><div><b>03</b><span>Layered Architecture</span></div><div><b>04</b><span>Docker · Git · GitHub · GitLab</span></div></div></div>
      </div>
    </section>

    <section class="stitch-section section-frame section-alt" id="ai">
      <div class="content-frame two-column-section">
        <header class="section-heading section-heading-side"><span class="section-index">AI INTEGRATION // 04</span><h2>{isArabic ? 'تكامل الذكاء الاصطناعي' : 'AI Integration'}</h2><p>{isArabic ? 'خبرة عملية في دمج نماذج ذكاء اصطناعي محلية ضمن أنظمة الـBackend لدعم التخطيط وإنشاء المهام وتحليل المشاريع.' : 'Practical experience integrating local AI models into backend workflows to support planning, task generation, and project analysis.'}</p></header>
        <div class="feature-grid"><article class="feature-panel"><span class="feature-number">01</span><h3>Ollama · Qwen</h3><p>{isArabic ? 'دمج نماذج محلية مع الـBackend وربط نتائجها بسير عمل إدارة المشاريع والمهام.' : 'Local model integration with backend workflows and project/task management results.'}</p><div class="token-row"><span class="tech-token">Ollama</span><span class="tech-token">Qwen</span></div></article><article class="feature-panel"><span class="feature-number">02</span><h3>{isArabic ? 'قدرات مساعدة' : 'Assisted capabilities'}</h3><p>{isArabic ? 'إنشاء المبادرات والمهام وتحليل المخاطر وأسباب التأخير وتقديم الاقتراحات.' : 'Initiative and task generation, risk analysis, delay analysis, and planning recommendations.'}</p></article></div>
      </div>
    </section>

    <section class="stitch-section section-frame section-alt" id="stack">
      <div class="content-frame">
        <header class="section-heading"><div><span class="section-index">TECHNICAL SYSTEM // 05</span><h2>{copy.stack}</h2></div><p>{copy.stackIntro}</p></header>
        <div class="stack-grid">
          {skills.map((group) => (
            <article class="stack-panel"><span class="stack-category">{group.data.category.replace('-', ' & ')}</span><div class="stack-items">{group.data.items.map((item) => <span class="stack-item tech-token">{isArabic ? item.nameAr || item.name : item.name}</span>)}</div></article>
          ))}
        </div>
      </div>
    </section>

    <section class="stitch-section section-frame" id="experience">
      <div class="content-frame">
        <header class="section-heading"><div><span class="section-index">CAREER RECORD // 06</span><h2>{copy.experience}</h2></div><p>{copy.experienceIntro}</p></header>
        <div class="record-grid">
          <div><h3 class="record-heading">{copy.work}</h3>{workEntries.map((entry) => <article class="record-item"><span class="record-period">{isArabic ? entry.data.periodAr || entry.data.period : entry.data.period}</span><h4>{isArabic ? entry.data.titleAr || entry.data.title : entry.data.title}</h4><p>{isArabic ? entry.data.descriptionAr || entry.data.description : entry.data.description}</p><ul class="record-points">{(isArabic ? entry.data.contributionsAr : entry.data.contributions).map((point) => <li>{point}</li>)}</ul><div class="token-row">{(isArabic ? entry.data.skillsAr || entry.data.skills : entry.data.skills)?.map((skill) => <span class="tech-token">{skill}</span>)}</div></article>)}</div>
          <div><h3 class="record-heading">{copy.education}</h3>{educationEntry && <article class="record-item education-record"><span class="record-period">{isArabic ? educationEntry.data.periodAr || educationEntry.data.period : educationEntry.data.period}</span><h4>{isArabic ? educationEntry.data.titleAr || educationEntry.data.title : educationEntry.data.title}</h4><p>{isArabic ? educationEntry.data.descriptionAr || educationEntry.data.description : educationEntry.data.description}</p></article>}<h3 class="record-heading languages-heading">{copy.languages}</h3><article class="language-list">
          <span>{isArabic ? 'العربية' : 'Arabic'} <b>{isArabic ? 'اللغة الأم' : 'Native'}</b></span>
          <span>{isArabic ? 'الإنجليزية' : 'English'} <b>{isArabic ? 'متوسط (B1)' : 'Intermediate (B1)'}</b></span>
          </article>
          </div>
          </div>
      </div>
    </section>

    <section class="stitch-contact section-frame section-contact" id="contact">
      <div class="contact-glow" aria-hidden="true"></div>
      <div class="content-frame contact-content"><span class="section-index">CONTACT // 07</span><h2>{copy.contact}</h2><p>{copy.contactIntro}</p><a class="stitch-button stitch-button-primary" href={`mailto:${siteConfig.author.email}`}>{copy.secondary} <span aria-hidden="true">↗</span></a><div class="contact-grid"><a href={`mailto:${siteConfig.author.email}`}><small>{copy.email}</small><strong>{siteConfig.author.email}</strong></a><a href={`tel:${siteConfig.author.phone.replace(/\s/g, '')}`}><small>{copy.phone}</small><strong>{siteConfig.author.phone}</strong></a><div><small>{copy.location}</small><strong>{author.location}</strong></div><a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer"><small>{copy.linkedin}</small><strong>abdallah-hijazi-2287712b3</strong></a><a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer"><small>{copy.github}</small><strong>AbdallahHijazi</strong></a></div></div>
    </section>
  </main>

  <style>
    .stitch-home { min-height: 100vh; background: var(--color-bg); }
    .content-frame { width: min(100% - 3rem, 1280px); margin-inline: auto; position: relative; z-index: 1; }
    .section-frame { position: relative; border-bottom: 1px solid var(--color-border); overflow: hidden; }
    .section-alt { background: var(--color-bg-secondary); }
    .stitch-hero {
  padding: 3.5rem 0 5rem;
  min-height: auto;
  display: flex;
  align-items: center;
}
    .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 5rem; align-items: center; }
    .hero-glow { position: absolute; width: 420px; height: 320px; border-radius: 50%; filter: blur(120px); pointer-events: none; opacity: 0.3; }
    .hero-glow-cyan { background: var(--color-accent); inset-block-start: 12%; inset-inline-start: 10%; opacity: 0.08; }
    .hero-glow-violet { background: var(--color-violet); inset-block-start: 30%; inset-inline-end: 16%; opacity: 0.07; }
    .hero-copy { max-width: 820px; }
    .status-pill, .verification-row, .token-row, .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; }
    .status-pill { width: fit-content; padding: 0.5rem 0.75rem; border: 1px solid var(--color-border); background: var(--color-bg-elevated); border-radius: var(--border-radius-sm); color: var(--color-text-secondary); font: 0.6875rem 'JetBrains Mono', monospace; letter-spacing: 0.08em; text-transform: uppercase; }
    .status-dot, .profile-caption i { width: 0.45rem; height: 0.45rem; border-radius: 50%; background: var(--color-success); box-shadow: 0 0 12px rgba(52, 211, 153, 0.7); display: inline-block; }
    .hero-copy h1 { margin: 1.5rem 0; max-width: 850px; font-size: clamp(2.75rem, 6vw, 5.25rem); line-height: 1.06; letter-spacing: -0.04em; font-weight: 600; }
    .hero-copy h1 span { color: var(--color-text-secondary); }
    .hero-intro { max-width: 650px; font-size: 1.125rem; color: var(--color-text-secondary); }
    .hero-pillars { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; max-width: 760px; margin: 2rem 0; }
    .pillar, .feature-panel, .stack-panel, .record-item, .project-panel { background: var(--color-bg-elevated); border: 1px solid var(--color-border); }
    .pillar { padding: 1rem; border-radius: var(--border-radius-md); }
    .pillar span, .section-index, .stack-category, .record-period, .panel-topline { display: block; color: var(--color-accent); font: 0.625rem 'JetBrains Mono', monospace; letter-spacing: 0.09em; text-transform: uppercase; }
    .pillar strong { display: block; margin-top: 0.45rem; color: var(--color-text); font-size: 0.875rem; }
    .stitch-button { display: inline-flex; align-items: center; justify-content: center; gap: 0.6rem; min-height: 2.75rem; padding: 0.7rem 1rem; border-radius: var(--border-radius-md); font-size: 0.8125rem; font-weight: 600; text-decoration: none; transition: 180ms ease; }
    .stitch-button-primary { background: var(--color-text); color: var(--color-bg); }
    .stitch-button-primary:hover { background: var(--color-accent-hover); color: var(--color-bg); transform: translateY(-2px); }
    .stitch-button-secondary, .stitch-button-quiet { border: 1px solid var(--color-border); background: var(--color-bg-elevated); color: var(--color-text); }
    .stitch-button-secondary:hover, .stitch-button-quiet:hover { border-color: var(--color-accent); color: var(--color-accent); }
    .verification-row { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--color-border); color: var(--color-text-muted); font: 0.6875rem 'JetBrains Mono', monospace; }
    .verification-row a { color: inherit; }
    .verification-row b { color: var(--color-accent); font-weight: 500; }
    .profile-frame { width: 100%; max-width: 320px; padding: 0.5rem; border: 1px solid rgba(56, 189, 248, 0.25); border-radius: 1rem; background: var(--color-bg-elevated); box-shadow: 0 0 36px rgba(56, 189, 248, 0.08); position: relative; top: -3rem; }
    .profile-placeholder { aspect-ratio: 1; display: grid; place-items: center; border-radius: 0.75rem; background: radial-gradient(circle at 35% 25%, rgba(56, 189, 248, 0.35), transparent 32%), linear-gradient(135deg, var(--color-bg-focused), var(--color-violet-muted)); color: var(--color-text); font: 4.5rem 'Geist', sans-serif; letter-spacing: -0.08em; }
    .profile-placeholder img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: inherit;
      display: block;
    }
    .profile-caption { padding: 1rem 0.75rem 0.5rem; text-align: center; }
    .profile-caption strong, .profile-caption span, .profile-caption small { display: block; }
    .profile-caption strong { color: var(--color-text); font-size: 0.9375rem; }
    .profile-caption span { margin-top: 0.3rem; color: var(--color-accent); font: 0.6875rem 'JetBrains Mono', monospace; }
    .profile-caption small { display: flex; align-items: center; justify-content: center; gap: 0.4rem; margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--color-border); color: var(--color-text-muted); font: 0.625rem 'JetBrains Mono', monospace; text-transform: uppercase; }
    .stitch-section { padding: 6rem 0; }
    .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 2rem; padding-bottom: 1.5rem; margin-bottom: 2rem; border-bottom: 1px solid var(--color-border); }
    .section-heading h2 { margin: 0.45rem 0 0; font-size: clamp(1.75rem, 3vw, 2.75rem); letter-spacing: -0.03em; }
    .section-heading > p { max-width: 420px; margin: 0; color: var(--color-text-secondary); font-size: 0.9375rem; }
    .section-index { color: var(--color-accent); }
    .project-grid, .stack-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
    .project-panel { display: block; padding: 1.5rem; border-radius: var(--border-radius-lg); color: inherit; transition: 180ms ease; }
    .project-panel:hover { border-color: rgba(56, 189, 248, 0.4); background: var(--color-bg-focused); transform: translateY(-3px); }
    .panel-topline { display: flex; justify-content: space-between; gap: 1rem; color: var(--color-text-muted); }
    .panel-topline em { color: var(--color-success); font-style: normal; }
    .project-panel h3 { margin: 1.5rem 0 0.65rem; font-size: 1.25rem; line-height: 1.25; }
    .project-panel p { min-height: 4.8rem; margin-bottom: 1.25rem; font-size: 0.875rem; }
    .token-row { gap: 0.45rem; }
    .token-row .tech-token, .stack-item { padding: 0.3rem 0.5rem; border: 1px solid var(--color-border); border-radius: var(--border-radius-sm); color: var(--color-text-secondary); background: var(--color-bg-secondary); font: 0.65rem 'JetBrains Mono', monospace; }
    .panel-link { display: block; margin-top: 1.5rem; color: var(--color-accent); font: 0.6875rem 'JetBrains Mono', monospace; }
    .two-column-section { display: grid; grid-template-columns: minmax(240px, 0.8fr) minmax(0, 1.5fr); gap: 4rem; align-items: start; }
    .section-heading-side { display: block; padding: 0; margin: 0; border: 0; }
    .section-heading-side h2 { margin-bottom: 1rem; }
    .section-heading-side p { max-width: 34rem; }
    .feature-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
    .feature-panel { padding: 1.5rem; border-radius: var(--border-radius-md); }
    .feature-number { color: var(--color-violet); font: 0.6875rem 'JetBrains Mono', monospace; }
    .feature-panel h3 { margin: 2rem 0 0.65rem; font-size: 1.125rem; }
    .feature-panel p { font-size: 0.875rem; }
