---
/**
 * SEO Component
 * 
 * Generates comprehensive meta tags for SEO, Open Graph, and Twitter Cards.
 * Should be placed in the "head" slot of BaseLayout.
 * 
 * Features:
 * - Page title with site name suffix
 * - Meta description
 * - Canonical URL
 * - Open Graph tags for social sharing
 * - Twitter Card tags
 * - Article-specific metadata (publish/update dates)
 * 
 * @component
 * 
 * @example
 * ```astro
 * <BaseLayout>
 *   <SEO 
 *     slot="head"
 *     title="About Me" 
 *     description="Learn more about my background"
 *   />
 *   <div>Content</div>
 * </BaseLayout>
 * ```
 */
import { siteConfig } from '../config';
import { getAlternateLocale, getAlternatePath, getLocale, getLocaleFromPath, localizePath, stripLocale } from '../i18n/utils';

interface Props {
  /** Page title (will be suffixed with author name unless noSuffix is true) */
  title: string;
  
  /** Page description for meta tags */
  description?: string;
  
  /** Skip adding site name suffix to title (useful for homepage) */
  noSuffix?: boolean;
  
  /** Page type for Open Graph */
  type?: 'website' | 'article' | 'profile';
  
  /** Social sharing image URL */
  image?: string;
  
  /** Article publish date (for articles) */
  publishDate?: Date;
  
  /** Article updated date (for articles) */
  updatedDate?: Date;
  
  /** Canonical URL override */
  canonicalURL?: string;
}

const {
  title,
  description = siteConfig.description,
  type = 'website',
  image,
  publishDate,
  updatedDate,
  canonicalURL,
  noSuffix = false,
} = Astro.props;

const locale = getLocale(Astro.locals.locale || Astro.url.searchParams.get('_locale') || getLocaleFromPath(Astro.url.pathname));
const siteName = locale === 'ar'
  ? 'Abdallah Ahmad Hijazi | مطور Backend'
  : siteConfig.title;
const alternateLocale = getAlternateLocale(locale);
const localizedPath = localizePath(stripLocale(Astro.url.pathname), locale);
const alternatePath = getAlternatePath(Astro.url.pathname, locale);

// Generate full title with site name suffix (unless noSuffix is true)
const fullTitle = noSuffix ? title : (title ? `${title} | ${siteConfig.author.name}` : siteConfig.title);

// Get the current URL from Astro
const currentURL = canonicalURL || new URL(localizedPath, Astro.site || siteConfig.url).href;

// Get site URL from config
const siteURL = siteConfig.url.endsWith('/') ? siteConfig.url : `${siteConfig.url}/`;



// Default image if none provided
const defaultImage = `${siteURL}og-image.png`;
const ogImage = image || defaultImage;

// Ensure image is absolute URL
const absoluteImageURL = ogImage.startsWith('http') ? ogImage : `${siteURL}${ogImage.replace(/^\//, '')}`;

// Get Twitter handle from config (extract username from URL)
const twitterHandle = siteConfig.social.twitter 
  ? `@${siteConfig.social.twitter.split('/').pop()}`
  : undefined;
---

<!-- Page Title -->
<title>{fullTitle}</title>

<!-- Meta Description -->
<meta name="description" content={description} />

<!-- Canonical URL -->
<link rel="canonical" href={currentURL} />
<link rel="alternate" hreflang={locale} href={currentURL} />
<link rel="alternate" hreflang={alternateLocale} href={new URL(alternatePath, Astro.site || siteConfig.url).href} />
<link rel="alternate" hreflang="x-default" href={new URL(localizePath(stripLocale(Astro.url.pathname), 'en'), Astro.site || siteConfig.url).href} />

<!-- Author -->
<meta name="author" content={siteConfig.author.name} />

<!-- Open Graph Tags -->
<meta property="og:type" content={type} />
<meta property="og:url" content={currentURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteImageURL} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={locale === 'ar' ? 'ar_AR' : 'en_US'} />
<meta property="og:locale:alternate" content={locale === 'ar' ? 'en_US' : 'ar_AR'} />

<!-- Article-specific Open Graph tags -->
{type === 'article' && publishDate && (
  <>
    <meta property="article:published_time" content={publishDate.toISOString()} />
    {updatedDate && (
      <meta property="article:modified_time" content={updatedDate.toISOString()} />
    )}
  </>
)}

<!-- Twitter Card Tags -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={currentURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImageURL} />
{twitterHandle && <meta name="twitter:site" content={twitterHandle} />}
{twitterHandle && <meta name="twitter:creator" content={twitterHandle} />}
